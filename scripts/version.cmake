# Runs on every build. Writes the version header, vX.Y.Z[-dev]-<commit>-beta, and a source file with the build's time
# in UTC. "dev" marks a build whose HEAD is not the commit that the tag vX.Y.Z points to. Each file is written only
# when it changes, so the header costs a rebuild only on a new commit.
# Run as: cmake -DSOURCE_DIR=... -DVERSION=X.Y.Z -DGIT=<git> -DOUTPUT=<header> -DTIME_OUTPUT=<source> -P version.cmake

function(write_if_changed path content)
  set(existing "")
  if(EXISTS "${path}")
    file(READ "${path}" existing)
  endif()
  if(NOT existing STREQUAL content)
    file(WRITE "${path}" "${content}")
  endif()
endfunction()

set(head "")
set(tagged "")
set(count "")
if(GIT)
  execute_process(COMMAND "${GIT}" -C "${SOURCE_DIR}" rev-parse HEAD
                  OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND "${GIT}" -C "${SOURCE_DIR}" rev-parse -q --verify "refs/tags/v${VERSION}^{commit}"
                  OUTPUT_VARIABLE tagged OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  # The build number: how many commits lead to HEAD. It only grows along main, which is how updates tell newer builds.
  execute_process(COMMAND "${GIT}" -C "${SOURCE_DIR}" rev-list --count HEAD
                  OUTPUT_VARIABLE count OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()
if(NOT count MATCHES "^[0-9]+$")
  set(count "0")
endif()

if(head MATCHES "^[0-9a-f]+$")
  string(SUBSTRING "${head}" 0 8 commit)
else()
  set(commit "00000000")
endif()

set(text "v${VERSION}")
if(NOT head MATCHES "^[0-9a-f]+$" OR NOT head STREQUAL tagged)
  string(APPEND text "-dev")
endif()
string(APPEND text "-${commit}-beta")

write_if_changed("${OUTPUT}" "// Generated by scripts/version.cmake on each build.
#ifndef SSTK_VERSION_H
#define SSTK_VERSION_H
#define SSTK_VERSION_TEXT \"${text}\"
#define SSTK_VERSION_WIDE L\"${text}\"
#define SSTK_BUILD_NUMBER ${count}
#endif
")

string(TIMESTAMP built "%Y-%m-%d %H:%M:%S" UTC)
write_if_changed("${TIME_OUTPUT}" "// Generated by scripts/version.cmake on each build.
#include \"sstk/base/product.h\"

namespace sstk {

extern const wchar_t kBuildTime[] = L\"${built} UTC\";

}  // namespace sstk
")
