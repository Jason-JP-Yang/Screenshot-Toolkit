# Writes the version header on every build: vX.Y.Z[-dev]-<commit>-beta and the commit's date.
# "dev" marks a build whose HEAD is not the commit that the tag vX.Y.Z points to.
# Run as: cmake -DSOURCE_DIR=... -DVERSION=X.Y.Z -DGIT=<git> -DOUTPUT=<header> -P version.cmake

set(head "")
set(tagged "")
set(day "")
if(GIT)
  execute_process(COMMAND "${GIT}" -C "${SOURCE_DIR}" rev-parse HEAD
                  OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND "${GIT}" -C "${SOURCE_DIR}" rev-parse -q --verify "refs/tags/v${VERSION}^{commit}"
                  OUTPUT_VARIABLE tagged OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND "${GIT}" -C "${SOURCE_DIR}" log -1 --format=%cs
                  OUTPUT_VARIABLE day OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()

if(head MATCHES "^[0-9a-f]+$")
  string(SUBSTRING "${head}" 0 8 commit)
else()
  set(commit "00000000")
endif()

set(text "v${VERSION}")
if(NOT head MATCHES "^[0-9a-f]+$" OR NOT head STREQUAL tagged)
  string(APPEND text "-dev")
endif()
string(APPEND text "-${commit}-beta")

set(date "")
if(day MATCHES "^([0-9]+)-([0-9]+)-([0-9]+)$")
  set(names Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec)
  math(EXPR month "${CMAKE_MATCH_2} - 1")
  math(EXPR dom "${CMAKE_MATCH_3}")
  list(GET names ${month} month_name)
  set(date "${month_name} ${dom}, ${CMAKE_MATCH_1}")
endif()

set(content "// Generated by scripts/version.cmake on each build.
#ifndef SSTK_VERSION_H
#define SSTK_VERSION_H
#define SSTK_VERSION_TEXT \"${text}\"
#define SSTK_VERSION_WIDE L\"${text}\"
#define SSTK_VERSION_DATE L\"${date}\"
#endif
")

set(existing "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
