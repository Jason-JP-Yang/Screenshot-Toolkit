#include <winres.h>

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SSTK_VERSION_NUMBERS
PRODUCTVERSION SSTK_VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Screenshot Toolkit"
      VALUE "FileVersion", SSTK_VERSION_TEXT
      VALUE "InternalName", "ScreenshotToolkit"
      VALUE "OriginalFilename", "ScreenshotToolkit.exe"
      VALUE "ProductName", "Screenshot Toolkit"
      VALUE "ProductVersion", SSTK_VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
